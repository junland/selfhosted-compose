services:
  jenkins:
    build:
      context: .
      dockerfile: Containerfile
    image: 'localhost/jenkins:latest'
    container_name: jenkins-app-service
    hostname: 'jenkins'
    restart: always
    privileged: true
    tty: true
    group_add:
      - 1001
    volumes:
      - ci_app_data_dev:/var/jenkins_home
      - ./conf/jenkins.yml:/var/jenkins_home/jenkins.yml:ro
      - ci_app_data_ssh:/etc/jenkins/ssh:ro
      - ${SELFHOSTED_CONTAINER_RUNTIME_SOCKET_FILE}:/var/run/docker.sock
    environment:
      JAVA_OPTS: ${SELFHOSTED_JENKINS_JAVA_OPTS}
      DOCKER_HOST: ${SELFHOSTED_DOCKER_HOST}
      CASC_JENKINS_CONFIG: /var/jenkins_home/jenkins.yml
      TZ: ${SELFHOSTED_TZ}
    healthcheck:
      test: curl -sfL http://localhost:8080/login || exit 1
      interval: 30s
      timeout: 30s
      retries: 8
      start_period: 120s
    labels:
      - "io.containers.autoupdate=registry"
      - "com.infra.service=ci"
    cap_add:
      - SYS_CHROOT

  agent:
    build:
      context: .
      dockerfile: Containerfile.agent
    image: 'localhost/jenkins-agent:latest'
    container_name: jenkins-agent-service
    hostname: 'jenkins-agent'
    restart: always
    privileged: true
    user: root
    tty: true
    devices:
      - "/dev/tty:/dev/tty"
    expose:
      - 22
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ci_app_data_ssh:/home/jenkins/.ssh:ro
    environment:
      JAVA_OPTS: ${SELFHOSTED_JENKINS_AGENT_JAVA_OPTS}
      DOCKER_HOST: ${SELFHOSTED_DOCKER_HOST}
      TZ: ${SELFHOSTED_TZ}
    secrets:
      - source: host_ssh_key
        target: /home/jenkins/.ssh/authorized_keys
    healthcheck:
      test: nc -zv 127.0.0.1 22
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    labels:
      - "io.containers.autoupdate=registry"
      - "com.infra.service=ci"
    cap_add:
      - SYS_CHROOT

secrets:
  host_ssh_key:
    file: /root/.ssh/jenkins_agent_key.pub

volumes:
  ci_app_data_dev:
    name: ci_app_data_dev
    labels:
      backup: 'true'
  ci_app_data_ssh:
    name: ci_app_data_ssh
    labels:
      backup: 'true'
