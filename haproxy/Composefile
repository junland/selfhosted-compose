services:
  haproxy:
    build:
      context: .
      dockerfile: Containerfile
    image: localhost/haproxy:latest
    container_name: haproxy-web-service
    hostname: 'haproxy'
    restart: unless-stopped
    ports:
      - '80:80'
      - '443:443'
    environment:
      TZ: ${SELFHOSTED_TZ}
    volumes:
      - ./conf:/etc/haproxy:rw
      - /var/run/haproxy:/var/run/haproxy:rw
      - "${SELFHOSTED_HAPROXY_EXTERNAL_CERTS_DIR:?SELFHOSTED_HAPROXY_EXTERNAL_CERTS_DIR is required}:/var/lib/haproxy/certs:ro"
    healthcheck:
      test: curl -sS --fail http://localhost:8080/ || exit 1
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    labels:
      - "io.containers.autoupdate=local"
      - "com.infra.service=haproxy"
