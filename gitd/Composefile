services:
  gitd:
    image: 'codeberg.org/forgejo/forgejo:15'
    container_name: gitd-app-service
    hostname: 'gitd'
    restart: unless-stopped
    environment:
      TZ: ${SELFHOSTED_TZ}
      USER_UID: ${SELFHOSTED_GITD_USER_UID}
      USER_GID: ${SELFHOSTED_GITD_USER_GID}
    healthcheck:
      test: curl -sS --fail http://localhost:3000/ || exit 1
      interval: 40s
      timeout: 30s
      retries: 5
      start_period: 60s
    volumes:
      - gitd_data:/data
    labels:
      - "io.containers.autoupdate=registry"
      - "com.infra.service=gitd"

volumes:
  gitd_data:
    name: 'gitd_app_data'
    labels:
      backup: 'true'
